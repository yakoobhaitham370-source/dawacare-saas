# Copy to .env.integration.local (ignored). Use ONLY a separate development project.
DAWACARE_TEST_ENVIRONMENT=development
DAWACARE_TEST_ALLOW_WRITES=YES_SYNTHETIC_DEVELOPMENT
DAWACARE_TEST_SUPABASE_URL=
DAWACARE_TEST_SUPABASE_PUBLISHABLE_KEY=
DAWACARE_TEST_SUPABASE_SERVICE_ROLE_KEY=
DAWACARE_TEST_DATABASE_URL=
DAWACARE_TEST_PROJECT_REF=
# Owned mailbox domain for synthetic hosted-test accounts; local Mailpit intercepts example.test.
DAWACARE_TEST_EMAIL_DOMAIN=
# Optional: separate Netlify development origin. Production origin is rejected.
DAWACARE_TEST_NETLIFY_URL=
