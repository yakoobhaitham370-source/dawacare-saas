VITE_SUPABASE_ANON_KEY=
VITE_DAWACARE_ENVIRONMENT=development
VITE_DAWACARE_DEVELOPMENT_PROJECT_REF=
# Server/functions ONLY. Never give these names a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:8888
DAWACARE_ENVIRONMENT=development
DAWACARE_DEVELOPMENT_PROJECT_REF=
# Optional extraction service; manual entry works without AI.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
